### Matches - save (uus, tulevikus, mõlemad võistkonnad teada)
# Seedi järel on andmebaasis 70 mängu, seega uus mäng saab ID 71 (vt. Matches - list)
POST {{host}}/api/Matches/save
Content-Type: application/json

{ "id": 0, "tournamentId": 2, "stage": 3, "startTime": "2030-07-01T18:00:00", "homeTeamId": 3, "awayTeamId": 4 }

### Matches - save (VIGANE: tournamentId puudub)
POST {{host}}/api/Matches/save
Content-Type: application/json

{ "id": 0, "tournamentId": 99999, "stage": 3, "startTime": "2026-11-01T18:00:00" }

### Matches - save (VIGANE: stage = 99)
POST {{host}}/api/Matches/save
Content-Type: application/json

{ "id": 0, "tournamentId": 1, "stage": 99, "startTime": "2026-11-01T18:00:00" }

### Matches - save (VIGANE: negatiivsed väravad)
POST {{host}}/api/Matches/save
Content-Type: application/json

{ "id": 0, "tournamentId": 1, "stage": 0, "startTime": "2026-11-01T18:00:00", "homeTeamGoals": -5, "awayTeamGoals": -1 }

### Matches - delete
DELETE {{host}}/api/Matches/delete
Content-Type: application/json

{ "id": 1 }

### Predictions - save (uus)
# Ennustada saab ainult mängule, mis pole veel alanud ja mille võistkonnad on teada.
# Selleks sobib eelmises sammus loodud mäng (ID 71).
POST {{host}}/api/Predictions/save
Content-Type: application/json

{ "id": 0, "userId": 1, "matchId": 71, "homeTeamGoals": 2, "awayTeamGoals": 1 }

### Predictions - save (VIGANE: userId puudub)
POST {{host}}/api/Predictions/save
Content-Type: application/json

{ "id": 0, "userId": 99999, "matchId": 1, "homeTeamGoals": 2, "awayTeamGoals": 1 }

### Predictions - save (VIGANE: sama kasutaja + mäng uuesti)
POST {{host}}/api/Predictions/save
Content-Type: application/json

{ "id": 0, "userId": 1, "matchId": 71, "homeTeamGoals": 0, "awayTeamGoals": 0 }

### Predictions - save (VIGANE: negatiivsed väravad)
POST {{host}}/api/Predictions/save
Content-Type: application/json

{ "id": 0, "userId": 1, "matchId": 71, "homeTeamGoals": -3, "awayTeamGoals": 100 }

### Predictions - delete
DELETE {{host}}/api/Predictions/delete
Content-Type: application/json

{ "id": 1 }

### Predictions - save (VIGANE: homeTeamGoals on tekst)
POST {{host}}/api/Predictions/save
Content-Type: application/json

{ "id": 0, "userId": 1, "matchId": 3, "homeTeamGoals": "abc", "awayTeamGoals": 1 }

############ VALIDAATORID: lisatestid ############
# Käivita päringud ükshaaval (mitte kõiki järjest): delete-päringud on hävitavad
# ja vanad testid kustutavad näiteks turniiri 1, võistkonna 1 ja kasutaja 2.
# NB! ID-d eeldavad puhast, seedi andmetega andmebaasi:
# 35 võistkonda, 35 turniiri, 70 mängu (poolfinaal + finaal igal turniiril).
# Turniir 17 (FIFA World Cup 2002) mängud 33 ja 34 on ennustustega.
# Mängud 69 ja 70 (UEFA Euro 2028) on tulevikus ja võistkonnad on teadmata.
# Kui ID-d on teised, vaadake õiged väärtused list-päringutest.

### Teams - list (VIGANE: page = 0)
GET {{host}}/api/Teams/list?page=0&pageSize=10

### Teams - list (VIGANE: pageSize = 0)
GET {{host}}/api/Teams/list?page=1&pageSize=0

### Teams - list (VIGANE: pageSize = 1000)
GET {{host}}/api/Teams/list?page=1&pageSize=1000

### Tournaments - list (VIGANE: page = 0)
GET {{host}}/api/Tournaments/list?page=0&pageSize=10

### Tournaments - list (VIGANE: pageSize = 0)
GET {{host}}/api/Tournaments/list?page=1&pageSize=0

### Tournaments - list (VIGANE: pageSize = 1000)
GET {{host}}/api/Tournaments/list?page=1&pageSize=1000

### Matches - list (VIGANE: page = 0)
GET {{host}}/api/Matches/list?page=0&pageSize=10

### Matches - list (VIGANE: pageSize = 0)
GET {{host}}/api/Matches/list?page=1&pageSize=0

### Matches - list (VIGANE: pageSize = 1000)
GET {{host}}/api/Matches/list?page=1&pageSize=1000

### Users - list (VIGANE: page = 0)
GET {{host}}/api/Users/list?page=0&pageSize=10

### Users - list (VIGANE: pageSize = 0)
GET {{host}}/api/Users/list?page=1&pageSize=0

### Users - list (VIGANE: pageSize = 1000)
GET {{host}}/api/Users/list?page=1&pageSize=1000

### Predictions - list (VIGANE: page = 0)
GET {{host}}/api/Predictions/list?page=0&pageSize=10

### Predictions - list (VIGANE: pageSize = 0)
GET {{host}}/api/Predictions/list?page=1&pageSize=0

### Predictions - list (VIGANE: pageSize = 1000)
GET {{host}}/api/Predictions/list?page=1&pageSize=1000


