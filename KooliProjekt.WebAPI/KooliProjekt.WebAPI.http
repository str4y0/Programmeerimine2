############ SAVE / DELETE ############

### Teams - save (uus)
POST {{host}}/api/Teams/save
Content-Type: application/json

{ "id": 0, "name": "Testimaa" }

### Teams - save (muutmine)
POST {{host}}/api/Teams/save
Content-Type: application/json

{ "id": 1, "name": "Muudetud nimi" }

### Teams - save (VIGANE: name puudub)
POST {{host}}/api/Teams/save
Content-Type: application/json

{ "id": 0 }

### Teams - save (VIGANE: id puudub)
POST {{host}}/api/Teams/save
Content-Type: application/json

{ "id": 99999, "name": "X" }

### Teams - save (VIGANE: dubleeriv nimi)
POST {{host}}/api/Teams/save
Content-Type: application/json

{ "id": 0, "name": "Testimaa" }

### Teams - delete
DELETE {{host}}/api/Teams/delete
Content-Type: application/json

{ "id": 1 }

### Teams - delete (VIGANE: puudub)
DELETE {{host}}/api/Teams/delete
Content-Type: application/json

{ "id": 99999 }

