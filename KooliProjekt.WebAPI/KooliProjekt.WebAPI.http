############ FAILID (võistkonna lipp/logo) ############
# NB! Võistkonna 3 failid salvestatakse kausta <FilesRoot>/teams/3/
# Kasuta ID-na võistkonda, mis olemas on (vt. Teams - list).

@teamId = 3
# Pärast "listfiles" päringut kopeeri siia mõne faili nimi (GUID + laiend):
@fileName = kopeeri-siia-failinimi.png

### Teams - addfile (KORREKTNE: PNG)
POST {{host}}/api/Teams/addfile?id={{teamId}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="lipp.png"
Content-Type: image/png

< ./TestFiles/lipp.png
--WebAppBoundary--

### Teams - addfile (VIGANE: ei ole pilt, .txt)
POST {{host}}/api/Teams/addfile?id={{teamId}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="tekst.txt"
Content-Type: text/plain

< ./TestFiles/tekst.txt
--WebAppBoundary--

### Teams - addfile (VIGANE: võistkonda ei ole)
POST {{host}}/api/Teams/addfile?id=99999
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="lipp.png"
Content-Type: image/png

< ./TestFiles/lipp.png
--WebAppBoundary--

### Teams - addfile (VIGANE: id = 0)
POST {{host}}/api/Teams/addfile?id=0
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="lipp.png"
Content-Type: image/png

< ./TestFiles/lipp.png
--WebAppBoundary--

### Teams - addfile (VIGANE: faili ei lisatud)
POST {{host}}/api/Teams/addfile?id={{teamId}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="midagi"

tühi
--WebAppBoundary--

### Teams - listfiles (võistkonna failid)
GET {{host}}/api/Teams/listfiles/{{teamId}}

### Teams - listfiles (KORREKTNE: võistkonnal pole faile, tühi list)
GET {{host}}/api/Teams/listfiles/5

### Teams - listfiles (VIGANE: võistkonda ei ole)
GET {{host}}/api/Teams/listfiles/99999

### Teams - getfile (KORREKTNE: tagastab pildi)
GET {{host}}/api/Teams/getfile/{{teamId}}/{{fileName}}

### Teams - getfile (VIGANE: faili ei ole, 404)
GET {{host}}/api/Teams/getfile/{{teamId}}/olematu-fail.png

### Teams - getfile (VIGANE: võistkonda ei ole)
GET {{host}}/api/Teams/getfile/99999/{{fileName}}

### Teams - getfile (VIGANE: kaustateega failinimi)
GET {{host}}/api/Teams/getfile/{{teamId}}/..%2F..%2Fappsettings.json

### Teams - deletefile (KORREKTNE)
DELETE {{host}}/api/Teams/deletefile
Content-Type: application/json

{ "teamId": {{teamId}}, "fileName": "{{fileName}}" }

### Teams - deletefile (VIGANE: faili ei ole)
DELETE {{host}}/api/Teams/deletefile
Content-Type: application/json

{ "teamId": {{teamId}}, "fileName": "olematu-fail.png" }

### Teams - deletefile (VIGANE: kaustateega failinimi)
DELETE {{host}}/api/Teams/deletefile
Content-Type: application/json

{ "teamId": {{teamId}}, "fileName": "../../appsettings.json" }

### Teams - deletefile (VIGANE: failinimi puudub)
DELETE {{host}}/api/Teams/deletefile
Content-Type: application/json

{ "teamId": {{teamId}} }

### Teams - deletefile (VIGANE: võistkonda ei ole)
DELETE {{host}}/api/Teams/deletefile
Content-Type: application/json

{ "teamId": 99999, "fileName": "x.png" }

# Võistkonna kustutamine peab kustutama ka tema failid:
# 1) "Teams - save (uus)" loob võistkonna Testimaa (esimene vaba ID, seedi järel 36)
# 2) lisa sellele fail, 3) kustuta võistkond, 4) kontrolli, et kaust <FilesRoot>/teams/36 on tühi

@newTeamId = 36

### Teams - addfile (uuele võistkonnale)
POST {{host}}/api/Teams/addfile?id={{newTeamId}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="lipp.png"
Content-Type: image/png

< ./TestFiles/lipp.png
--WebAppBoundary--

### Teams - delete (uus võistkond koos failiga)
DELETE {{host}}/api/Teams/delete
Content-Type: application/json

{ "id": {{newTeamId}} }

